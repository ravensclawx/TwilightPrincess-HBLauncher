# Static AArch64 musl toolchain for HBLauncher ABI 3.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(HBX_TOOLCHAIN "$ENV{HBXL_TOOLCHAIN}" CACHE PATH "Patched musl toolchain")
if(NOT EXISTS "${HBX_TOOLCHAIN}/bin/aarch64-linux-musl-gcc")
  message(FATAL_ERROR "Set HBXL_TOOLCHAIN to the patched musl toolchain")
endif()
foreach(pair "C;gcc" "CXX;g++" "ASM;gcc")
  list(GET pair 0 lang)
  list(GET pair 1 tool)
  set(CMAKE_${lang}_COMPILER "${HBX_TOOLCHAIN}/bin/aarch64-linux-musl-${tool}")
endforeach()
set(CMAKE_AR "${HBX_TOOLCHAIN}/bin/aarch64-linux-musl-ar")
set(CMAKE_RANLIB "${HBX_TOOLCHAIN}/bin/aarch64-linux-musl-ranlib")
set(CMAKE_SYSROOT "${HBX_TOOLCHAIN}/aarch64-linux-musl")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(flags "-mbranch-protection=bti -fno-pie -fno-pic -ffunction-sections -fdata-sections -DHBX_SWITCH2=1")
set(CMAKE_C_FLAGS_INIT "${flags}")
set(CMAKE_CXX_FLAGS_INIT "${flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -no-pie")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(THREADS_PREFER_PTHREAD_FLAG ON)
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
