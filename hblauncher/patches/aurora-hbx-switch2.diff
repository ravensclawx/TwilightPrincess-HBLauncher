diff --git a/cmake/AuroraNodProvider.cmake b/cmake/AuroraNodProvider.cmake
index 3bcbbdf..7f14398 100644
--- a/cmake/AuroraNodProvider.cmake
+++ b/cmake/AuroraNodProvider.cmake
@@ -38,7 +38,16 @@ if (_aurora_nod_provider STREQUAL "auto")
   message(STATUS "aurora: nod auto-resolved provider: ${_aurora_nod_provider}")
 endif ()
 
-if (_aurora_nod_provider STREQUAL "vendor")
+if (_aurora_nod_provider STREQUAL "hbx")
+  # HBLauncher Switch 2: nod-lite (plain GameCube ISO reader) instead of the
+  # Rust nod library.  AURORA_NOD_LITE_DIR holds nod_lite.c and nod.h.
+  if (NOT TARGET nod::nod)
+    add_library(nod_lite STATIC "${AURORA_NOD_LITE_DIR}/nod_lite.c")
+    target_include_directories(nod_lite PUBLIC "${AURORA_NOD_LITE_DIR}")
+    target_link_libraries(nod_lite PUBLIC Threads::Threads)
+    add_library(nod::nod ALIAS nod_lite)
+  endif ()
+elseif (_aurora_nod_provider STREQUAL "vendor")
   # ── Vendor: FetchContent + Corrosion build from source ──
   if (NOT TARGET nod::nod)
     message(STATUS "aurora: Building nod (provider=vendor, linkage=${AURORA_NOD_LINKAGE})")
