diff -ruN sdl3-orig/src/audio/hbx/SDL_hbxaudio.c sdl3/src/audio/hbx/SDL_hbxaudio.c
--- sdl3-orig/src/audio/hbx/SDL_hbxaudio.c	1969-12-31 18:00:00.000000000 -0600
+++ sdl3/src/audio/hbx/SDL_hbxaudio.c	2026-10-28 13:49:30.114958865 -0500
@@ -0,0 +1,213 @@
+/*
+  SDL audio driver for HBLauncher (Switch 2, Linux personality).
+
+  Plays through nn::audio AudioOut using the entrypoints the HBLauncher host
+  resolves into ctx->audio (the same path the native NES app uses).  The
+  AudioOut object, descriptors and PCM live in SDK-heap memory, which the
+  audio service accepts.  48 kHz, stereo, s16; SDL converts anything else.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_HBX
+
+#include "../SDL_sysaudio.h"
+#include "hbx_sdk.h"
+
+extern const struct hbx_ctx *hbxl_ctx;
+void *hbxl_sdk_memalign(size_t align, size_t size);
+void hbxl_sdk_free(void *p);
+
+#define HBX_AUDIO_BUFFERS 4
+#define HBX_AUDIO_FRAMES 1024
+#define HBX_AUDIO_BUFFER_BYTES (HBX_AUDIO_FRAMES * 4)
+
+typedef void (*hbx_init_param_fn)(void *);
+typedef int32_t (*hbx_open_fn)(void *, const void *);
+typedef int32_t (*hbx_query_fn)(void *);
+typedef void (*hbx_set_info_fn)(void *, const void *, uint64_t, uint64_t);
+typedef int32_t (*hbx_append_fn)(void *, void *);
+typedef void *(*hbx_released_fn)(void *);
+
+struct hbx_audio_mem {
+    unsigned char object[0x800];
+    unsigned char descriptors[HBX_AUDIO_BUFFERS][0x40];
+    unsigned char pad[0x1000 - 0x800 - HBX_AUDIO_BUFFERS * 0x40];
+    unsigned char pcm[HBX_AUDIO_BUFFERS][HBX_AUDIO_BUFFER_BYTES];
+};
+
+struct SDL_PrivateAudioData
+{
+    struct hbx_audio_mem *mem;
+    bool busy[HBX_AUDIO_BUFFERS];
+    int queued;
+    int current;
+    bool started;
+    bool opened;
+};
+
+#define API(field, type) ((type)(uintptr_t)hbxl_ctx->audio.field)
+
+static void HBXAUDIO_Reclaim(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    int guard;
+    for (guard = 0; guard <= HBX_AUDIO_BUFFERS; guard++) {
+        void *released = API(released_buffer, hbx_released_fn)(h->mem->object);
+        int i;
+        if (!released) {
+            return;
+        }
+        for (i = 0; i < HBX_AUDIO_BUFFERS; i++) {
+            if (released == h->mem->descriptors[i] && h->busy[i]) {
+                h->busy[i] = false;
+                h->queued--;
+                break;
+            }
+        }
+    }
+}
+
+static int HBXAUDIO_FreeSlot(SDL_AudioDevice *device)
+{
+    int i;
+    for (i = 0; i < HBX_AUDIO_BUFFERS; i++) {
+        if (!device->hidden->busy[i]) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static bool HBXAUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    while (!SDL_GetAtomicInt(&device->shutdown)) {
+        HBXAUDIO_Reclaim(device);
+        if (HBXAUDIO_FreeSlot(device) >= 0) {
+            return true;
+        }
+        SDL_Delay(2);
+    }
+    return true;
+}
+
+static Uint8 *HBXAUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    h->current = HBXAUDIO_FreeSlot(device);
+    if (h->current < 0) {
+        h->current = 0;     // WaitDevice guarantees a slot; stay defensive
+    }
+    *buffer_size = HBX_AUDIO_BUFFER_BYTES;
+    return h->mem->pcm[h->current];
+}
+
+static bool HBXAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    int i = h->current;
+    if (i < 0 || h->busy[i]) {
+        return true;
+    }
+    API(set_buffer_info, hbx_set_info_fn)(h->mem->descriptors[i], h->mem->pcm[i],
+                                          HBX_AUDIO_BUFFER_BYTES, (uint64_t)buflen);
+    if (API(append_buffer, hbx_append_fn)(h->mem->object, h->mem->descriptors[i]) != 1) {
+        return true;        // dropped; keep the stream alive
+    }
+    h->busy[i] = true;
+    h->queued++;
+    if (!h->started && h->queued >= 2) {
+        if (API(start, hbx_query_fn)(h->mem->object) == 0) {
+            h->started = true;
+        }
+    }
+    return true;
+}
+
+static void HBXAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    int tries;
+    if (!h) {
+        return;
+    }
+    if (h->opened) {
+        if (h->started) {
+            API(stop, hbx_query_fn)(h->mem->object);
+        }
+        API(flush_buffers, hbx_query_fn)(h->mem->object);
+        for (tries = 0; tries < 40 && h->queued > 0; tries++) {
+            HBXAUDIO_Reclaim(device);
+            if (h->queued > 0) {
+                SDL_Delay(1);
+            }
+        }
+        if (hbxl_ctx->audio.close) {
+            API(close, hbx_query_fn)(h->mem->object);
+        }
+    }
+    if (h->mem) {
+        hbxl_sdk_free(h->mem);
+    }
+    SDL_free(h);
+    device->hidden = NULL;
+}
+
+static bool HBXAUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h;
+    uint32_t parameter[4] = { 0, 0, 0, 0 };
+
+    if (device->recording) {
+        return SDL_SetError("hbx: recording is not supported");
+    }
+    if (!hbxl_ctx || !hbxl_ctx->audio.open_default_audio_out || !hbxl_ctx->audio.append_buffer) {
+        return SDL_SetError("hbx: the host provided no AudioOut entrypoints");
+    }
+    h = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*h));
+    if (!h) {
+        return false;
+    }
+    device->hidden = h;
+    h->mem = (struct hbx_audio_mem *)hbxl_sdk_memalign(0x1000, sizeof(struct hbx_audio_mem));
+    if (!h->mem) {
+        return SDL_SetError("hbx: no SDK heap memory for AudioOut");
+    }
+    SDL_memset(h->mem, 0, sizeof(*h->mem));
+
+    API(initialize_parameter, hbx_init_param_fn)(parameter);
+    parameter[0] = 48000;
+    parameter[1] = (parameter[1] & 0xFFFF0000u) | 2;
+    if (API(open_default_audio_out, hbx_open_fn)(h->mem->object, parameter) != 0) {
+        return SDL_SetError("hbx: OpenDefaultAudioOut failed");
+    }
+    h->opened = true;
+    if (API(sample_rate, hbx_query_fn)(h->mem->object) != 48000 ||
+        API(channel_count, hbx_query_fn)(h->mem->object) != 2 ||
+        API(sample_format, hbx_query_fn)(h->mem->object) != 2) {
+        return SDL_SetError("hbx: AudioOut format is not 48 kHz stereo s16");
+    }
+
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.channels = 2;
+    device->spec.freq = 48000;
+    device->sample_frames = HBX_AUDIO_FRAMES;
+    SDL_UpdatedAudioDeviceFormat(device);
+    return true;
+}
+
+static bool HBXAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = HBXAUDIO_OpenDevice;
+    impl->CloseDevice = HBXAUDIO_CloseDevice;
+    impl->WaitDevice = HBXAUDIO_WaitDevice;
+    impl->GetDeviceBuf = HBXAUDIO_GetDeviceBuf;
+    impl->PlayDevice = HBXAUDIO_PlayDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    return true;
+}
+
+AudioBootStrap HBXAUDIO_bootstrap = {
+    "hbx", "HBLauncher Switch 2 AudioOut", HBXAUDIO_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_HBX
