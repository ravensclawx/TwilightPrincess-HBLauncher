diff -ruN sdl3-orig/src/joystick/hbx/SDL_hbxjoystick.c sdl3/src/joystick/hbx/SDL_hbxjoystick.c
--- sdl3-orig/src/joystick/hbx/SDL_hbxjoystick.c	1969-12-31 18:00:00.000000000 -0600
+++ sdl3/src/joystick/hbx/SDL_hbxjoystick.c	2026-10-28 13:50:13.497571040 -0500
@@ -0,0 +1,148 @@
+/*
+  SDL joystick driver for HBLauncher (Switch 2, Linux personality).
+
+  One always-present Switch Pro style controller fed by the HBLauncher SDK
+  pad poll (hbx_input_poll: handheld, full-key and dual Joy-Con sources).
+  The GUID carries Nintendo's vendor/product so SDL reports a Switch Pro
+  gamepad type, and the mapping keeps Nintendo's positional layout
+  (B = south, A = east).
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_HBX
+
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+#include "hbx_sdk.h"
+#include "hbx_app.h"
+
+extern const struct hbx_ctx *hbxl_ctx;
+
+enum { HBXJ_A, HBXJ_B, HBXJ_X, HBXJ_Y, HBXJ_L, HBXJ_R, HBXJ_ZL, HBXJ_ZR, HBXJ_PLUS,
+       HBXJ_MINUS, HBXJ_LSTICK, HBXJ_RSTICK, HBXJ_BUTTONS };
+
+static const uint32_t hbxj_bits[HBXJ_BUTTONS] = {
+    HBX_A, HBX_B, HBX_X, HBX_Y, HBX_L, HBX_R, HBX_ZL, HBX_ZR, HBX_PLUS, HBX_MINUS,
+    HBX_STICK_L, HBX_STICK_R
+};
+
+static SDL_JoystickID hbxj_instance;
+static struct hbx_input_state hbxj_input;
+
+static SDL_GUID HBXJ_GUID(void)
+{
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_VIRTUAL, 0x057e, 0x2009, 0x0100,
+                                  "Nintendo", "HBLauncher Controller", 'h', 0);
+}
+
+static bool HBXJ_Init(void)
+{
+    char guid[33];
+    char mapping[512];
+    if (!hbxl_ctx) {
+        return true;                // no controller outside HBLauncher
+    }
+    SDL_GUIDToString(HBXJ_GUID(), guid, sizeof(guid));
+    SDL_snprintf(mapping, sizeof(mapping),
+                 "%s,HBLauncher Controller,a:b%d,b:b%d,x:b%d,y:b%d,leftshoulder:b%d,"
+                 "rightshoulder:b%d,lefttrigger:b%d,righttrigger:b%d,start:b%d,back:b%d,"
+                 "leftstick:b%d,rightstick:b%d,dpup:h0.1,dpright:h0.2,dpdown:h0.4,"
+                 "dpleft:h0.8,leftx:a0,lefty:a1,rightx:a2,righty:a3,",
+                 guid, HBXJ_B, HBXJ_A, HBXJ_Y, HBXJ_X, HBXJ_L, HBXJ_R, HBXJ_ZL, HBXJ_ZR,
+                 HBXJ_PLUS, HBXJ_MINUS, HBXJ_LSTICK, HBXJ_RSTICK);
+    SDL_AddGamepadMapping(mapping);
+    hbxj_instance = SDL_GetNextObjectID();
+    SDL_PrivateJoystickAdded(hbxj_instance);
+    return true;
+}
+
+static int HBXJ_GetCount(void) { return hbxl_ctx ? 1 : 0; }
+static void HBXJ_Detect(void) {}
+static bool HBXJ_IsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+    return false;
+}
+static const char *HBXJ_GetDeviceName(int device_index) { return "HBLauncher Controller"; }
+static const char *HBXJ_GetDevicePath(int device_index) { return NULL; }
+static int HBXJ_GetDeviceSteamVirtualGamepadSlot(int device_index) { return -1; }
+static int HBXJ_GetDevicePlayerIndex(int device_index) { return 0; }
+static void HBXJ_SetDevicePlayerIndex(int device_index, int player_index) {}
+static SDL_GUID HBXJ_GetDeviceGUID(int device_index) { return HBXJ_GUID(); }
+static SDL_JoystickID HBXJ_GetDeviceInstanceID(int device_index) { return hbxj_instance; }
+
+static bool HBXJ_Open(SDL_Joystick *joystick, int device_index)
+{
+    joystick->nbuttons = HBXJ_BUTTONS;
+    joystick->naxes = 4;
+    joystick->nhats = 1;
+    SDL_memset(&hbxj_input, 0, sizeof(hbxj_input));
+    return true;
+}
+
+static bool HBXJ_Rumble(SDL_Joystick *joystick, Uint16 low, Uint16 high) { return SDL_Unsupported(); }
+static bool HBXJ_RumbleTriggers(SDL_Joystick *joystick, Uint16 l, Uint16 r) { return SDL_Unsupported(); }
+static bool HBXJ_SetLED(SDL_Joystick *joystick, Uint8 r, Uint8 g, Uint8 b) { return SDL_Unsupported(); }
+static bool HBXJ_SendEffect(SDL_Joystick *joystick, const void *data, int size) { return SDL_Unsupported(); }
+static bool HBXJ_SetSensorsEnabled(SDL_Joystick *joystick, bool enabled) { return SDL_Unsupported(); }
+
+static Sint16 HBXJ_Axis(int32_t v, bool invert)
+{
+    int32_t s = v * 327;
+    if (invert) {
+        s = -s;
+    }
+    if (s > 32767) s = 32767;
+    if (s < -32768) s = -32768;
+    return (Sint16)s;
+}
+
+static void HBXJ_Update(SDL_Joystick *joystick)
+{
+    Uint64 now = SDL_GetTicksNS();
+    Uint8 hat = SDL_HAT_CENTERED;
+    int i;
+    hbx_input_poll(hbxl_ctx, &hbxj_input);
+    for (i = 0; i < HBXJ_BUTTONS; i++) {
+        SDL_SendJoystickButton(now, joystick, (Uint8)i, (hbxj_input.buttons & hbxj_bits[i]) != 0);
+    }
+    if (hbxj_input.buttons & HBX_UP) hat |= SDL_HAT_UP;
+    if (hbxj_input.buttons & HBX_RIGHT) hat |= SDL_HAT_RIGHT;
+    if (hbxj_input.buttons & HBX_DOWN) hat |= SDL_HAT_DOWN;
+    if (hbxj_input.buttons & HBX_LEFT) hat |= SDL_HAT_LEFT;
+    SDL_SendJoystickHat(now, joystick, 0, hat);
+    // SDK sticks are -100..100 with +y up; SDL wants +y down.
+    SDL_SendJoystickAxis(now, joystick, 0, HBXJ_Axis(hbxj_input.stick_lx, false));
+    SDL_SendJoystickAxis(now, joystick, 1, HBXJ_Axis(hbxj_input.stick_ly, true));
+    SDL_SendJoystickAxis(now, joystick, 2, HBXJ_Axis(hbxj_input.stick_rx, false));
+    SDL_SendJoystickAxis(now, joystick, 3, HBXJ_Axis(hbxj_input.stick_ry, true));
+}
+
+static void HBXJ_Close(SDL_Joystick *joystick) {}
+static void HBXJ_Quit(void) {}
+static bool HBXJ_GetGamepadMapping(int device_index, SDL_GamepadMapping *out) { return false; }
+
+SDL_JoystickDriver SDL_HBX_JoystickDriver = {
+    HBXJ_Init,
+    HBXJ_GetCount,
+    HBXJ_Detect,
+    HBXJ_IsDevicePresent,
+    HBXJ_GetDeviceName,
+    HBXJ_GetDevicePath,
+    HBXJ_GetDeviceSteamVirtualGamepadSlot,
+    HBXJ_GetDevicePlayerIndex,
+    HBXJ_SetDevicePlayerIndex,
+    HBXJ_GetDeviceGUID,
+    HBXJ_GetDeviceInstanceID,
+    HBXJ_Open,
+    HBXJ_Rumble,
+    HBXJ_RumbleTriggers,
+    HBXJ_SetLED,
+    HBXJ_SendEffect,
+    HBXJ_SetSensorsEnabled,
+    HBXJ_Update,
+    HBXJ_Close,
+    HBXJ_Quit,
+    HBXJ_GetGamepadMapping
+};
+
+#endif // SDL_JOYSTICK_HBX
